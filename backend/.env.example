# Copy to .env and fill in. .env is git-ignored.

PYDANTIC_AI_NO_BANNER=1

# Who writes conversations: agents (each character speaks for itself) or director (one call writes the scene)
CONVERSATION_ENGINE=agents

# Albert (OpenAI-compatible)
LLM_PROVIDER=openai
LLM_MODEL=mistral-medium-2508
LLM_BASE_URL=https://albert.api.etalab.gouv.fr/v1/
LLM_API_KEY=

# Free fake model for development (canned dialogue, no key needed):
# LLM_PROVIDER=fake

# Anthropic alternative:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5   # or claude-haiku-5-5, much cheaper
# LLM_BASE_URL=
# LLM_API_KEY=
